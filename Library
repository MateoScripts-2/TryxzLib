        -- 5. Slider
        function TabObj:CreateSlider(sOpts)
            sOpts = sOpts or {}
            local Min = sOpts.Min or 0
            local Max = sOpts.Max or 100
            local Increment = sOpts.Increment or 1
            local Suffix = sOpts.Suffix or ""
            local Value = math.clamp(sOpts.Default or Min, Min, Max)

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 50)
            Frame.BackgroundColor3 = Theme.Element
            Frame.Parent = Page
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

            local Lbl = Instance.new("TextLabel")
            Lbl.Size = UDim2.new(1, -80, 0, 22)
            Lbl.Position = UDim2.new(0, 12, 0, 4)
            Lbl.BackgroundTransparency = 1
            Lbl.Text = sOpts.Name or "Slider"
            Lbl.TextColor3 = Theme.Text
            Lbl.Font = Enum.Font.GothamSemibold
            Lbl.TextSize = 13
            Lbl.TextXAlignment = Enum.TextXAlignment.Left
            Lbl.Parent = Frame

            local ValLbl = Instance.new("TextLabel")
            ValLbl.Size = UDim2.new(0, 65, 0, 22)
            ValLbl.Position = UDim2.new(1, -77, 0, 4)
            ValLbl.BackgroundTransparency = 1
            ValLbl.Text = tostring(Value) .. Suffix
            ValLbl.TextColor3 = Theme.Accent
            ValLbl.Font = Enum.Font.GothamBold
            ValLbl.TextSize = 13
            ValLbl.TextXAlignment = Enum.TextXAlignment.Right
            ValLbl.Parent = Frame

            local BarBg = Instance.new("Frame")
            BarBg.Size = UDim2.new(1, -24, 0, 8)
            BarBg.Position = UDim2.new(0, 12, 0, 33)
            BarBg.BackgroundColor3 = Theme.Sidebar
            BarBg.Parent = Frame
            Instance.new("UICorner", BarBg).CornerRadius = UDim.new(1, 0)

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0)
            Fill.BackgroundColor3 = Theme.Accent
            Fill.Parent = BarBg
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local dragging = false
            local function SetValue(inputPos)
                local rel = math.clamp((inputPos.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
                local raw = Min + (Max - Min) * rel
                local snapped = math.floor(raw / Increment + 0.5) * Increment
                snapped = math.clamp(tonumber(string.format("%.2f", snapped)), Min, Max)
                Value = snapped
                ValLbl.Text = tostring(Value) .. Suffix
                Tween(Fill, {Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0)}, 0.08)
                if sOpts.Callback then task.spawn(sOpts.Callback, Value) end
            end

            BarBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    SetValue(input.Position)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    SetValue(input.Position)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            return {
                Set = function(_, val)
                    Value = math.clamp(val, Min, Max)
                    ValLbl.Text = tostring(Value) .. Suffix
                    Tween(Fill, {Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0)}, 0.15)
                    if sOpts.Callback then task.spawn(sOpts.Callback, Value) end
                end
            }
        end

