        -- 7. Dropdown & Multi-Dropdown
        function TabObj:CreateDropdown(dOpts)
            dOpts = dOpts or {}
            local Options = dOpts.Options or {}
            local Multi = dOpts.Multi or false
            local Selected = Multi and {} or (dOpts.Default or Options[1] or "Seleccionar")
            if Multi and type(dOpts.Default) == "table" then
                for _, v in ipairs(dOpts.Default) do Selected[v] = true end
            end

            local Opened = false
            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Theme.Element
            Frame.ClipsDescendants = true
            Frame.Parent = Page
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

            local Header = Instance.new("TextButton")
            Header.Size = UDim2.new(1, 0, 0, 38)
            Header.BackgroundTransparency = 1
            Header.Text = ""
            Header.Parent = Frame

            local Lbl = Instance.new("TextLabel")
            Lbl.Size = UDim2.new(0.5, -10, 1, 0)
            Lbl.Position = UDim2.new(0, 12, 0, 0)
            Lbl.BackgroundTransparency = 1
            Lbl.Text = dOpts.Name or "Dropdown"
            Lbl.TextColor3 = Theme.Text
            Lbl.Font = Enum.Font.GothamSemibold
            Lbl.TextSize = 13
            Lbl.TextXAlignment = Enum.TextXAlignment.Left
            Lbl.Parent = Header

            local StatusLbl = Instance.new("TextLabel")
            StatusLbl.Size = UDim2.new(0.5, -28, 1, 0)
            StatusLbl.Position = UDim2.new(0.5, 0, 0, 0)
            StatusLbl.BackgroundTransparency = 1
            StatusLbl.TextColor3 = Theme.Accent
            StatusLbl.Font = Enum.Font.Gotham
            StatusLbl.TextSize = 12
            StatusLbl.TextXAlignment = Enum.TextXAlignment.Right
            StatusLbl.TextTruncate = Enum.TextTruncate.AtEnd
            StatusLbl.Parent = Header

            local Arrow = Instance.new("TextLabel")
            Arrow.Size = UDim2.new(0, 20, 1, 0)
            Arrow.Position = UDim2.new(1, -24, 0, 0)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = Theme.SubText
            Arrow.Font = Enum.Font.GothamBold
            Arrow.TextSize = 11
            Arrow.Parent = Header

            local ListFrame = Instance.new("Frame")
            ListFrame.Size = UDim2.new(1, -16, 0, 0)
            ListFrame.Position = UDim2.new(0, 8, 0, 40)
            ListFrame.BackgroundTransparency = 1
            ListFrame.Parent = Frame

            local ListLayout = Instance.new("UIListLayout", ListFrame)
            ListLayout.Padding = UDim.new(0, 4)

            local function UpdateStatus(trigger)
                if Multi then
                    local list = {}
                    for k, v in pairs(Selected) do
                        if v then table.insert(list, k) end
                    end
                    StatusLbl.Text = #list > 0 and table.concat(list, ", ") or "Ninguno"
                    if trigger and dOpts.Callback then task.spawn(dOpts.Callback, list) end
                else
                    StatusLbl.Text = tostring(Selected)
                    if trigger and dOpts.Callback then task.spawn(dOpts.Callback, Selected) end
                end
            end

            local function RebuildOptions(newOpts)
                Options = newOpts or Options
                for _, child in ipairs(ListFrame:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                for _, opt in ipairs(Options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Size = UDim2.new(1, 0, 0, 28)
                    OptBtn.BackgroundColor3 = Theme.Sidebar
                    OptBtn.Text = "  " .. tostring(opt)
                    OptBtn.TextColor3 = (Multi and Selected[opt] or Selected == opt) and Theme.Accent or Theme.SubText
                    OptBtn.Font = Enum.Font.GothamSemibold
                    OptBtn.TextSize = 12
                    OptBtn.TextXAlignment = Enum.TextXAlignment.Left
                    OptBtn.Parent = ListFrame
                    Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 6)

                    OptBtn.MouseButton1Click:Connect(function()
                        TryxzLib:PlaySound(dOpts.Sound or Sounds.Click, 0.4)
                        if Multi then
                            Selected[opt] = not Selected[opt]
                            OptBtn.TextColor3 = Selected[opt] and Theme.Accent or Theme.SubText
                            UpdateStatus(true)
                        else
                            Selected = opt
                            for _, b in ipairs(ListFrame:GetChildren()) do
                                if b:IsA("TextButton") then b.TextColor3 = Theme.SubText end
                            end
                            OptBtn.TextColor3 = Theme.Accent
                            UpdateStatus(true)
                            Opened = false
                            Tween(Arrow, {Rotation = 0}, 0.2)
                            Tween(Frame, {Size = UDim2.new(1, 0, 0, 38)}, 0.22)
                        end
                    end)
                end
            end

            RebuildOptions(Options)
            UpdateStatus(false)

            Header.MouseButton1Click:Connect(function()
                TryxzLib:PlaySound(Sounds.Click, 0.4)
                Opened = not Opened
                local totalHeight = 44 + (#Options * 32)
                Tween(Arrow, {Rotation = Opened and 180 or 0}, 0.2)
                Tween(Frame, {Size = UDim2.new(1, 0, 0, Opened and totalHeight or 38)}, 0.25)
            end)

            return {
                Refresh = function(_, newOptions)
                    RebuildOptions(newOptions)
                    if Opened then
                        Tween(Frame, {Size = UDim2.new(1, 0, 0, 44 + (#Options * 32))}, 0.2)
                    end
                end
            }
        end

        return TabObj
    end

