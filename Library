function TryxzLib:PlaySound(soundId, volume)
    if not soundId or soundId == "" then return end
    local idStr = tostring(soundId)
    if not idStr:find("rbxassetid://") then
        idStr = "rbxassetid://" .. idStr
    end
    local snd = Instance.new("Sound")
    snd.SoundId = idStr
    snd.Volume = volume or 0.5
    snd.Parent = SoundFolder
    snd:Play()
    snd.Ended:Connect(function()
        snd:Destroy()
    end)
end

